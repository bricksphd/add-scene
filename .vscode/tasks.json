{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: watch"
    },
    {
      "label": "Launch Dev Host (inspect-extensions)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}\\scripts\\launch-dev-host.ps1 -ExtensionPath ${workspaceFolder} -Port 9230",
      "problemMatcher": []
    }
  ]
}
