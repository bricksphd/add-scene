{
  "name": "cs2510-game-engine",
  "displayName": "CS2510 Game Engine",
  "icon": "media/NESLego.png",
  "publisher": "bricksphd01",
  "author": "bricksphd",
  "repository": {
    "type": "git",
    "url": "https://github.com/bricksphd/add-scene"
  },
  "bugs": {
    "url": "https://github.com/bricksphd/add-scene/issues"
  },
  "homepage": "https://github.com/bricksphd/add-scene#readme",
  "keywords": [
    "game",
    "scaffold",
    "scene",
    "gameobject",
    "component",
    "cs2510",
    "javascript",
    "template"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension creates, renames, and deletes files in your workspace."
    }
  },
  "license": "MIT",
  "description": "Scaffold Scene, Game Object, and Component JS files from a .html file's context menu, with a matching <script> tag inserted automatically.",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "addScene.addScene",
        "title": "➕ Add Scene",
        "icon": "media/plus.svg"
      },
      {
        "command": "addScene.addGameObject",
        "title": "➕ Add Game Object",
        "icon": "media/plus.svg"
      },
      {
        "command": "addScene.addComponent",
        "title": "➕ Add Component",
        "icon": "media/plus.svg"
      },
      {
        "command": "addScene.createNewGame",
        "title": "🎮 Create New Game"
      },
      {
        "command": "addScene.deleteClass",
        "title": "🗑️ Delete Class"
      },
      {
        "command": "addScene.deleteComponent",
        "title": "🗑️ Delete Component"
      },
      {
        "command": "addScene.deleteGameObject",
        "title": "🗑️ Delete GameObject"
      },
      {
        "command": "addScene.deleteScene",
        "title": "🗑️ Delete Scene"
      },
      {
        "command": "addScene.renameClass",
        "title": "✏️ Rename Class"
      },
      {
        "command": "addScene.renameComponent",
        "title": "✏️ Rename Component"
      },
      {
        "command": "addScene.renameGameObject",
        "title": "✏️ Rename GameObject"
      },
      {
        "command": "addScene.renameScene",
        "title": "✏️ Rename Scene"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "addScene.renameClass",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && !(resourceDirname =~ /[\\\\/](components|gameObjects|scenes)$/)",
          "group": "1_addScene@5"
        },
        {
          "command": "addScene.renameComponent",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && resourceDirname =~ /[\\\\/]components$/",
          "group": "1_addScene@5"
        },
        {
          "command": "addScene.renameGameObject",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && resourceDirname =~ /[\\\\/]gameObjects$/",
          "group": "1_addScene@5"
        },
        {
          "command": "addScene.renameScene",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && resourceDirname =~ /[\\\\/]scenes$/",
          "group": "1_addScene@5"
        },
        {
          "command": "addScene.deleteClass",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && !(resourceDirname =~ /[\\\\/](components|gameObjects|scenes)$/)",
          "group": "1_addScene@6"
        },
        {
          "command": "addScene.deleteComponent",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && resourceDirname =~ /[\\\\/]components$/",
          "group": "1_addScene@6"
        },
        {
          "command": "addScene.deleteGameObject",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && resourceDirname =~ /[\\\\/]gameObjects$/",
          "group": "1_addScene@6"
        },
        {
          "command": "addScene.deleteScene",
          "when": "resourceExtname == .js && !explorerResourceIsFolder && resourceDirname =~ /[\\\\/]scenes$/",
          "group": "1_addScene@6"
        },
        {
          "command": "addScene.createNewGame",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "1_addScene@4"
        },
        {
          "command": "addScene.addScene",
          "when": "resourceExtname == .html",
          "group": "1_addScene@1"
        },
        {
          "command": "addScene.addGameObject",
          "when": "resourceExtname == .html",
          "group": "1_addScene@2"
        },
        {
          "command": "addScene.addComponent",
          "when": "resourceExtname == .html",
          "group": "1_addScene@3"
        }
      ],
      "editor/context": [
        {
          "command": "addScene.addScene",
          "when": "resourceExtname == .html",
          "group": "1_addScene@1"
        },
        {
          "command": "addScene.addGameObject",
          "when": "resourceExtname == .html",
          "group": "1_addScene@2"
        },
        {
          "command": "addScene.addComponent",
          "when": "resourceExtname == .html",
          "group": "1_addScene@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha",
    "test:unit": "mocha --spec out/test/unit/**/*.test.js",
    "test:integration": "npm run pretest && node ./out/test/runTest.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.0.0",
    "mocha": "^10.4.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  }
}
